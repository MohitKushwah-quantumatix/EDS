# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# eds-loader runtime files (generated at run-time, machine-specific)
# ---------------------------------------------------------------------------

# Incremental load state files (hash tracking — auto-regenerated on next run)
*_state.json
.eds_loader_state.json

# Windows Task Scheduler wrapper (auto-generated by eds-loader schedule)
.eds_loader_task.ps1
*.eds_loader_task.ps1

# Run history and metrics
.eds_loader_runs.jsonl
run_metrics.json

# Logs (runtime output — not source code)
logs/
*.log
*.task.log
rejected/

# ---------------------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------------------

# Environment files (may contain EDS_PG_PASSWORD, EDS_ENCRYPT_KEY, etc.)
.env
.env.*

# Inline-password loader configs (use password_env instead — then safe to commit)
# Uncomment the line below if your YAML files contain inline passwords:
# *.yaml

# Encryption key files (if accidentally written to disk)
*.key
*.pem
eds_encrypt_key*

# Reference loader YAML state files
.loader_*_state.json
